# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digital_surveyor"

# JWT Secret for Authentication
JWT_SECRET="digital-surveyor-jwt-secret-key-change-in-production"

# AI Inference Server URL
AI_SERVER_URL="http://localhost:8000"

# Prisma Engine Mirror (ensures engine downloads work even if binaries.prisma.sh is blocked)
PRISMA_ENGINES_MIRROR="https://registry.npmmirror.com/-/binary/prisma"
